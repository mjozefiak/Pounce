{
  "version": 1,
  "baseBranch": "auto",
  "tracker": "github",
  "browser": {
    "provider": "agent-browser"
  },
  "validation": {
    "commands": [
      "swift build",
      "swift test",
      "swift format lint --strict -r Sources Tests"
    ]
  },
  "labels": {
    "enabled": true,
    "pipeline": [
      "review",
      "changes-requested",
      "qa",
      "qa-failed",
      "merge-queue",
      "blocked",
      "do-not-merge"
    ],
    "category": [
      "bug",
      "feature",
      "refactor",
      "security",
      "dependencies",
      "documentation"
    ],
    "meta": [
      "needs-qa",
      "skip-qa",
      "qa-approved",
      "qa-self-verified",
      "in-progress",
      "ci-monitoring"
    ],
    "priority": [
      "priority-low",
      "priority-medium",
      "priority-high",
      "priority-extreme"
    ],
    "risk": [
      "risk-low",
      "risk-medium",
      "risk-high"
    ]
  },
  "qaGate": true,
  "ci": {
    "maxWaitMinutes": 40
  },
  "automerge": {
    "label": "automerge",
    "mode": "prepare-to-merge",
    "requireIndependentReview": false,
    "defaultToHumanQa": false,
    "humanOnlyLabels": [],
    "humanOnlyAuthors": [],
    "complexQa": "always",
    "windowMinutes": 120,
    "maxAttempts": 3,
    "eligibility": {
      "tiers": [
        [
          "qa-approved"
        ],
        [
          "ai-judgment"
        ],
        [
          "security",
          "small"
        ],
        [
          "trusted-author"
        ],
        [
          "fixes-issue"
        ]
      ],
      "smallPrFileLimit": 10,
      "aiJudgment": {
        "staleAfterDays": 7
      },
      "securityLabels": [
        "security"
      ],
      "trustedAuthors": [
        "mjozefiak"
      ],
      "excludeAuthorAssociations": [
        "first-time-contributor",
        "outside-collaborator",
        "none"
      ],
      "excludeLabels": [
        "do-not-merge",
        "blocked",
        "qa-failed"
      ],
      "lookbackDays": 30,
      "analyzeLimit": 100,
      "limit": 20
    }
  },
  "engine": {
    "loopStepThreshold": 20,
    "executorTier": "standard",
    "stepReview": "final"
  },
  "reviewSweep": {
    "maxParallel": 1,
    "coordinationRoot": null
  },
  "paths": {
    "runs": ".ai/runs",
    "analysis": ".ai/analysis",
    "specs": ".ai/specs",
    "dataModel": ".ai/data-model",
    "prototypes": ".ai/prototypes",
    "scripts": ".ai/scripts",
    "qa": ".ai/qa"
  },
  "designTokens": null,
  "reviewChecklist": null,
  "agentHarness": {
    "version": 1,
    "preset": "custom",
    "host": "claude",
    "delivery": {
      "mode": "stage-only",
      "issueClaim": "hold"
    },
    "retry": {
      "maxAttempts": 4,
      "backoffMs": 5000,
      "backoffMultiplier": 2,
      "timeoutEscalation": 1.5,
      "maxTimeoutMs": 2400000
    },
    "models": {},
    "profiles": {
      "standard": {
        "workers": [],
        "reviewers": [],
        "reviewPolicy": {
          "mode": "advisory"
        }
      }
    }
  },
  "closeKeywords": [],
  "dependencyAudit": {
    "minSeverity": "high",
    "ignore": []
  },
  "prTitleTemplate": "{prefix}({area}): {summary}{issueRef}",
  "ticketKeyPattern": ""
}
