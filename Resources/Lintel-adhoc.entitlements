<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Entitlements for a build whose signing identity has no Apple Team ID: every ad-hoc build (local, QA and
	pull-request builds). Under the hardened runtime, library validation only loads frameworks with the
	app's Team ID, so it would refuse the embedded SQLCipher.framework and llama.framework even though they
	are signed with the same ad-hoc identity. This entitlement turns library validation off and keeps the
	rest of the hardened runtime (no DYLD_* variables, no unsigned executable memory, no debugger
	attachment). A Developer ID build has a Team ID and uses Resources/Lintel.entitlements, which does not
	have it; scripts/select-entitlements.sh picks the file from the TeamIdentifier of the signature, not
	from the identity's name. See docs/signing.md.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!--
	Dictation records from the microphone; the hardened runtime requires this entitlement for any audio input.
	It changes the signed entitlements but not the designated requirement, so existing Accessibility, Full
	Disk Access and Keychain grants survive an update (docs/signing.md).
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
