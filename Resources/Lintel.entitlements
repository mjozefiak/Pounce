<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Entitlements for a build signed with a Developer ID identity (an Apple Team ID). The embedded
	SQLCipher.framework and llama.framework are signed with the same Team ID, so the hardened runtime's
	library validation loads them and this file has no com.apple.security.cs.disable-library-validation.
	A build without a Team ID (ad-hoc) would not start with this file; it uses
	Resources/Lintel-adhoc.entitlements. scripts/select-entitlements.sh picks the file from the
	TeamIdentifier of the signature. See docs/signing.md.
	-->
	<!--
	Dictation records from the microphone; the hardened runtime requires this entitlement for any audio input.
	It changes the signed entitlements but not the designated requirement, so existing Accessibility, Full
	Disk Access and Keychain grants survive an update (docs/signing.md).
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
